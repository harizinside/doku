# DOKU Payment Gateway credentials (from DOKU Back Office > Settings > API)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# RSA private key (PKCS#8 PEM, one line with \n escapes) — only needed for SNAP APIs
DOKU_PRIVATE_KEY=

# Optional: separate shared key for SNAP Direct Debit signing, if DOKU issued one
# (defaults to DOKU_SECRET_KEY)
DOKU_SHARED_KEY=

# sandbox | production
DOKU_ENV=sandbox

# Optional: override the base URL for Finance/Settlement APIs (host not yet confirmed by DOKU)
DOKU_FINANCE_BASE_URL=
